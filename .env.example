# VETA — required environment
#
# Two variables, both PUBLIC by design (the anon key is meant to reach the
# browser; RLS is what protects the data). Copy this file to `.env` and fill in
# your Supabase project's values — Supabase Dashboard → Project Settings → API.
#
# vite.config.js forwards them into the client bundle. It also accepts the
# UNPREFIXED names a Vercel ↔ Supabase integration injects automatically
# (SUPABASE_URL / SUPABASE_ANON_KEY), so on that host you set nothing by hand.
#
# NEVER put SUPABASE_SERVICE_ROLE_KEY or any other secret in this file: it is
# read at build time and anything named here that vite.config.js forwards ends
# up readable in the shipped JavaScript.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── pCon / OFML — ONLY for `npm run pcon:sync` ───────────────────────────────
#
# None of these are VITE_-prefixed and none may become so: they are read by a
# Node script, never by the browser, and PCON_CLIENT_SECRET / PCON_REFRESH_TOKEN
# are real credentials. Put them in your shell or your CI secrets, not in `.env`
# beside the public two above.
#
# PCON_CLIENT_ID CANNOT BE SELF-REGISTERED. pCon.login has no registration
# endpoint; EasternGraphics issues the id by email (support@easterngraphics.com).
# Until they answer, every other variable here is inert.
#
# PCON_CLIENT_ID=veta
# PCON_CLIENT_SECRET=                 # confidential clients only; omit for PKCE
# PCON_REFRESH_TOKEN=                 # from `npm run pcon:sync -- --login`
# PCON_EAIWS_URL=                     # EAIWS/Gatekeeper base URL, from the licence
# PCON_STARTUP=                       # startup file naming the manufacturer's data
# PCON_PACKAGE_GROUPS=
# PCON_LOCALE=en-US
# PCON_MANUFACTURER=                  # catalog root to sweep, e.g. `desede`
# PCON_GRADE_PROPERTY=                # e.g. `Leder.Qualitaet`. UNSET ⇒ ungraded,
#                                     # which is a real answer and not a fallback
# PCON_COVER_PROPERTY=                # e.g. `Leder.Farbe`
# VETA_BRAND=                         # the brand id these rows belong to
