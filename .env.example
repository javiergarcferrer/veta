# VETA — required environment
#
# Two variables, both PUBLIC by design (the anon key is meant to reach the
# browser; RLS is what protects the data). Copy this file to `.env` and fill in
# your Supabase project's values — Supabase Dashboard → Project Settings → API.
#
# vite.config.js forwards them into the client bundle. It also accepts the
# UNPREFIXED names a Vercel ↔ Supabase integration injects automatically
# (SUPABASE_URL / SUPABASE_ANON_KEY), so on that host you set nothing by hand.
#
# NEVER put SUPABASE_SERVICE_ROLE_KEY or any other secret in this file: it is
# read at build time and anything named here that vite.config.js forwards ends
# up readable in the shipped JavaScript.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
