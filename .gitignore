dist
node_modules

# Local secrets. `.env.example` documents the two PUBLIC variables; anything a
# developer keeps here is theirs. Never commit a service-role key: vite.config.js
# forwards build-time variables into the bundle, so a secret named in a .env
# reaches the browser.
.env
.env.local
.env.*.local

# Contabilidad. Los estados de cuenta de la tarjeta traen el consumo completo de
# la empresa — no van al repositorio; el ledger de recibos si, porque son las
# facturas de los proveedores. salida/ se regenera con `npm run 609`.
contabilidad/609/estado-cuenta/*
!contabilidad/609/estado-cuenta/EJEMPLO-estado-cuenta.csv
contabilidad/609/salida/
