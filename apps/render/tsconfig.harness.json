{
  // The BROWSER program: `src/harness.ts` and everything it pulls in. Separate
  // from the service's program because its dependency graph is three + three's
  // addons, which only exist here as a devDependency for the bundle — the node
  // service never imports them. Run it once `three` is installed:
  //   pnpm -F @veta/render typecheck:harness
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // No `node` types: this file runs in a page, and letting node's globals
    // resolve here is how a `process.env` read reaches a browser bundle.
    "types": [],
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "files": ["src/harness.ts"]
}
